# ========================================
# Snekid - Environment Configuration Example
# ========================================
# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit .env to version control!

# ========================================
# Google Gemini API Configuration
# ========================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini API Base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini Model Options:
#   - gemini-2.5-flash      : Balanced model, 1M token context (recommended)
#   - gemini-2.5-flash-lite : Fastest, most cost-efficient
#   - gemini-2.5-pro        : Best for complex reasoning
#   - gemini-3-flash-preview: Latest preview model
GEMINI_MODEL=gemini-2.5-flash

# ========================================
# API Timeouts (in seconds)
# ========================================
CONNECTION_TIMEOUT=30
RECEIVE_TIMEOUT=60
